{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "App": {
    "WebBaseUrl": "http://localhost:3000"
  },
  "Jwt": {
    "Issuer": "api-change-radar",
    "Audience": "api-change-radar-web",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 14
  },
  "RateLimiting": {
    "AuthPermitLimit": 10,
    "AuthWindowSeconds": 60
  },
  "Email": {
    "From": "API Change Radar <no-reply@apichangeradar.local>",
    "Smtp": {
      "Host": "",
      "Port": 1025
    }
  },
  "Crawler": {
    "Enabled": false,
    "PollMinutes": 15,
    "SourceIntervalMinutes": 60,
    "RequestTimeoutSeconds": 60,
    "MaxSpecBytes": 52428800
  }
}
